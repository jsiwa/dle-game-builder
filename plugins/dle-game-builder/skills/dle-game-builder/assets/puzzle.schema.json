{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jsiwa/dle-game-builder/main/plugins/dle-game-builder/skills/dle-game-builder/assets/puzzle.schema.json",
  "title": "DLE Puzzle Collection",
  "type": "object",
  "required": ["gameId", "resetTimeZone", "puzzles"],
  "properties": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resetTimeZone": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "puzzles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/puzzle" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "puzzle": {
      "type": "object",
      "required": [
        "id",
        "date",
        "kind",
        "title",
        "prompt",
        "difficulty",
        "status",
        "source",
        "reviewer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "enum": [
            "token-feedback",
            "attribute-deduction",
            "clue-ladder",
            "progressive-reveal",
            "connections",
            "ordering",
            "grid",
            "drawing",
            "estimation",
            "map-pin",
            "higher-lower",
            "custom"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "number" },
            { "type": "object" },
            { "type": "array" }
          ]
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "clues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "alt": { "type": "string" }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "solution": {
          "type": ["array", "object", "string", "number"]
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "type", "alt"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "type": { "enum": ["image", "audio", "video"] },
              "alt": { "type": "string" },
              "credit": { "type": "string" },
              "license": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "enum": ["draft", "review", "approved", "published", "retired"]
        },
        "source": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "license": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 1 }
          },
          "anyOf": [
            {
              "required": ["url"],
              "properties": { "url": { "type": "string", "format": "uri" } }
            },
            {
              "required": ["license"],
              "properties": { "license": { "type": "string", "minLength": 1 } }
            },
            {
              "required": ["notes"],
              "properties": { "notes": { "type": "string", "minLength": 1 } }
            }
          ],
          "additionalProperties": true
        },
        "editorialNotes": {
          "type": "string"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "normalizationNotes": {
          "type": "string"
        },
        "allowAnswerInPrompt": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "clue-ladder" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["answer", "clues"],
            "properties": {
              "answer": { "type": "string", "minLength": 1 },
              "clues": { "type": "array", "minItems": 2 }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "ordering" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["items", "solution"],
            "properties": {
              "items": { "type": "array", "minItems": 2, "uniqueItems": true },
              "solution": { "type": "array", "minItems": 2, "uniqueItems": true }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "progressive-reveal" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["answer", "media"],
            "properties": {
              "media": { "type": "array", "minItems": 2 }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
