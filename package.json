{
  "name": "dle-game-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-client packaging and validation for the DLE Game Builder Agent Skill.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:examples": "node plugins/dle-game-builder/skills/dle-game-builder/scripts/validate-puzzles.mjs plugins/dle-game-builder/skills/dle-game-builder/assets/example-puzzles.json",
    "validate": "npm run validate:package && npm run validate:examples && npm test"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
