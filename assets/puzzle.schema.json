{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/dle-puzzle.schema.json",
  "title": "DLE Puzzle Collection",
  "type": "object",
  "required": ["gameId", "resetTimeZone", "puzzles"],
  "properties": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resetTimeZone": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "puzzles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/puzzle" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "puzzle": {
      "type": "object",
      "required": ["id", "date", "kind", "title", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "enum": [
            "token-feedback",
            "attribute-deduction",
            "clue-ladder",
            "progressive-reveal",
            "connections",
            "ordering",
            "grid",
            "drawing",
            "estimation",
            "map-pin",
            "higher-lower",
            "custom"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "answer": {
          "type": ["string", "number", "object", "array"]
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "clues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "alt": { "type": "string" }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "solution": {
          "type": ["array", "object", "string", "number"]
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "type", "alt"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "type": { "enum": ["image", "audio", "video"] },
              "alt": { "type": "string" },
              "credit": { "type": "string" },
              "license": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "enum": ["draft", "review", "approved", "published", "retired"]
        },
        "source": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "license": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": true
        },
        "editorialNotes": {
          "type": "string"
        },
        "allowAnswerInPrompt": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    }
  }
}
